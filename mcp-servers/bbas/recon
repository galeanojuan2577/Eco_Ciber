#!/bin/bash
# BBAS Recon - Quick launcher for bug bounty recon
# Usage: recon [project_id]
#        recon start|stop|status|logs

set -euo pipefail

BBAS_DIR="/root/.config/bbas"
BBAS_DAEMON="$BBAS_DIR/bbas-daemon.py"
BBAS_CLI="$BBAS_DIR/bbas-cli.py"
PID_FILE="/tmp/bbas-daemon.pid"
LOG_FILE="/tmp/bbas-daemon.log"
PORT="${BBAS_PORT:-9000}"
WEB_UI_URL="http://localhost:${PORT}"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'
UNDERLINE='\033[4m'

# ─── Helpers ────────────────────────────────────────────────────
is_running() {
    local pid=$1
    kill -0 "$pid" 2>/dev/null
}

read_pid() {
    [[ -f "$PID_FILE" ]] && cat "$PID_FILE" 2>/dev/null
}

write_pid() {
    echo "$1" > "$PID_FILE"
}

remove_pid() {
    rm -f "$PID_FILE"
}

daemon_status() {
    local pid
    pid=$(read_pid)
    if [[ -n "$pid" ]] && is_running "$pid"; then
        echo "running"
        return 0
    else
        echo "stopped"
        return 1
    fi
}

wait_for_health() {
    local url="$1"
    local timeout="${2:-30}"
    echo -n "Waiting for daemon"
    for ((i=1; i<=timeout; i++)); do
        if curl -sf "$url/health" >/dev/null 2>&1; then
            echo -e " ${GREEN}✓ Ready!${NC}"
            return 0
        fi
        echo -n "."
        sleep 1
    done
    echo -e " ${RED}Timeout!${NC}"
    return 1
}

can_open_browser() {
    # Check if we have a working display/browser
    if [[ -n "${DISPLAY:-}" ]] || [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
        if command -v xdg-open >/dev/null 2>&1; then
            return 0
        fi
    fi
    if [[ "$(uname -s)" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

open_browser() {
    local url="$1"

    # SIEMPRE mostrar la URL en consola (clicable en la mayoría de terminales)
    echo ""
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  🌐  Abre la Web UI en:  ${GREEN}${UNDERLINE}$url${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""

    # Intentar abrir el navegador además de mostrar la URL
    if can_open_browser; then
        if command -v xdg-open >/dev/null 2>&1; then
            xdg-open "$url" >/dev/null 2>&1 &
            sleep 1
        elif command -v open >/dev/null 2>&1; then
            open "$url" >/dev/null 2>&1 &
            sleep 1
        fi
    fi
    return 0
}

# ─── Commands ───────────────────────────────────────────────────
cmd_start() {
    local status
    status=$(daemon_status)
    if [[ "$status" == "running" ]]; then
        local pid
        pid=$(read_pid)
        echo -e "${GREEN}✓ BBAS daemon already running (PID: $pid)${NC}"
        open_browser "$WEB_UI_URL"
        return 0
    fi

    echo -e "${YELLOW}⚠ Starting BBAS daemon on port ${PORT}...${NC}"
    cd "$BBAS_DIR"
    
    # Start with nohup + disown for true background persistence
    nohup python3 "$BBAS_DAEMON" --port "$PORT" >> "$LOG_FILE" 2>&1 &
    local daemon_pid=$!
    write_pid "$daemon_pid"
    disown "$daemon_pid"
    
    echo "Daemon PID: $daemon_pid"
    echo "Log file: $LOG_FILE"
    echo "PID file: $PID_FILE"
    
    if wait_for_health "$WEB_UI_URL" 30; then
        open_browser "$WEB_UI_URL"
        return 0
    else
        echo -e "${RED}Daemon failed to start. Check $LOG_FILE${NC}"
        return 1
    fi
}

cmd_stop() {
    local pid
    pid=$(read_pid)
    if [[ -z "$pid" ]]; then
        echo -e "${YELLOW}No PID file found. Daemon may not be running.${NC}"
        return 1
    fi
    
    if is_running "$pid"; then
        echo "Stopping daemon (PID: $pid)..."
        kill "$pid"
        for ((i=1; i<=10; i++)); do
            if ! is_running "$pid"; then
                break
            fi
            sleep 1
        done
        
        if is_running "$pid"; then
            kill -9 "$pid"
            echo "Force killed (SIGKILL)"
        fi
        remove_pid
        echo -e "${GREEN}Daemon stopped${NC}"
    else
        echo -e "${YELLOW}Process $pid not running${NC}"
        remove_pid
    fi
    return 0
}

cmd_status() {
    local pid
    pid=$(read_pid)
    if [[ -n "$pid" ]] && is_running "$pid"; then
        echo -e "${GREEN}Daemon is RUNNING (PID: $pid)${NC}"
        if curl -sf "$WEB_UI_URL/health" >/dev/null 2>&1; then
            local health
            health=$(curl -sf "$WEB_UI_URL/health")
            echo "Health: $health"
        else
            echo "Health check: FAILED (daemon not responding)"
        fi
    else
        echo -e "${RED}Daemon is STOPPED${NC}"
    fi
}

cmd_logs() {
    local follow=false
    local lines=100
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            -f|--follow) follow=true; shift ;;
            -n) lines="$2"; shift 2 ;;
            *) break ;;
        esac
    done
    
    if [[ ! -f "$LOG_FILE" ]]; then
        echo "Log file not found: $LOG_FILE"
        return 1
    fi
    
    if [[ "$follow" == true ]]; then
        tail -f -n "$lines" "$LOG_FILE"
    else
        tail -n "$lines" "$LOG_FILE"
    fi
}

cmd_restart() {
    cmd_stop
    sleep 2
    cmd_start
}

# ─── Main ──────────────────────────────────────────────────────
main() {
    local cmd="${1:-start}"
    shift || true
    
    case "$cmd" in
        start)   cmd_start "$@" ;;
        stop)    cmd_stop "$@" ;;
        restart) cmd_restart "$@" ;;
        status)  cmd_status ;;
        logs)    cmd_logs "$@" ;;
        *)
            echo "Usage: recon {start|stop|restart|status|logs} [options]"
            echo "  start   - Start daemon (default)"
            echo "  stop    - Stop daemon"
            echo "  restart - Restart daemon"
            echo "  status  - Show daemon status"
            echo "  logs    - Show daemon logs (use -f to follow)"
            echo ""
            echo "Environment variables:"
            echo "  BBAS_PORT  - Daemon port (default: 9000)"
            echo "  CYBER_PROJECT - Active project ID"
            return 1
            ;;
    esac
}

if [[ $# -gt 0 ]]; then
    main "$@"
    exit $?
fi

# ─── Interactive Mode ───────────────────────────────────────────
echo -e "${BLUE}╔══════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║                    BBAS RECON LAUNCHER                      ║${NC}"
echo -e "${BLUE}╚══════════════════════════════════════════════════════════╝${NC}"
echo

# Check/set project
if [[ -z "${CYBER_PROJECT:-}" ]]; then
    echo -e "${YELLOW}⚠ No active project (CYBER_PROJECT not set)${NC}"
    echo "Available projects:"
    python3 "$BBAS_CLI" project list 2>/dev/null | sed 's/^/  /'
    echo
    read -p "Enter project ID: " PROJECT_ID
    if [[ -n "$PROJECT_ID" ]]; then
        export CYBER_PROJECT="$PROJECT_ID"
        echo -e "${GREEN}✓ Project set to: $PROJECT_ID${NC}"
    else
        echo "No project selected. Exiting."
        exit 1
    fi
else
    echo -e "${GREEN}✓ Active project: $CYBER_PROJECT${NC}"
fi

# Start daemon if needed
if [[ "$(daemon_status)" != "running" ]]; then
    cmd_start
fi

# Open Web UI - this now shows URL if browser can't auto-open
open_browser "$WEB_UI_URL"

echo
echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}BBAS is ready! Web UI: $WEB_UI_URL${NC}"
echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
echo
echo "Quick commands:"
echo "  recon start|stop|restart|status|logs"
echo "  bbas scan recon \"api.example.com\" --deep"
echo "  bbas findings list --min-severity high"
echo "  bbas paths list"
echo ""
echo "MCP Integration (in opencode):"
echo "  'Start a recon scan on api.example.com'"
echo "  'Show me critical findings for my project'"
echo "  'Create attack path from IDOR to account takeover'"

# Keep interactive session alive
echo -e "${YELLOW}Press Ctrl+C to exit (daemon keeps running in background)${NC}"
while true; do sleep 3600; done
