{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nvidia": {
      "options": {
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "qwen/qwen3.5-397b-a17b": {
          "name": "Qwen 3.5",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    },
    "opencode": {
      "models": {
        "deepseek-v4-flash-free": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "default_agent": "build",
  "skills": {
    "paths": [
      "__OPENCODE_ROOT__/skills",
      "__OPENCODE_ROOT__/skills-ecc"
    ]
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "__LOCAL_BIN__/mcp-server-sequential-thinking"
      ]
    },
    "memory": {
      "type": "local",
      "command": [
        "__LOCAL_BIN__/mcp-server-memory"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "__LOCAL_BIN__/mcp-server-filesystem",
        "__HOME__/BugBounty"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--executable-path",
        "/usr/bin/chromium",
        "--headless"
      ]
    },
    "agent-browser": {
      "type": "local",
      "command": [
        "__LOCAL_BIN__/agent-browser",
        "mcp",
        "--executable-path",
        "/usr/bin/chromium"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "edit": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "allow"
  }
}
