{
  "name": "[MASTER] - Sistema Integral Citas Pro v1.0",
  "nodes": [
    {
      "parameters": { "updates": ["message"] },
      "id": "telegram-bot-trigger",
      "name": "Bot Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [100, 200]
    },
    {
      "parameters": { "path": "get-citas", "options": { "cors": true } },
      "id": "api-get-webhook",
      "name": "API Dashboard GET",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 400]
    },
    {
      "parameters": { "httpMethod": "POST", "path": "cancelar-cita", "options": { "cors": true } },
      "id": "api-post-webhook",
      "name": "API Dashboard POST",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 600]
    },
    {
      "parameters": { "rule": { "interval": [{ "field": "hours" }] } },
      "id": "cron-reminder-trigger",
      "name": "Cron Recordatorios",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 800]
    },
    {
      "parameters": {},
      "id": "error-notif-trigger",
      "name": "Error Monitor",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [100, 1000]
    },
    {
      "parameters": {
        "operation": "lookup",
        "documentId": "ID_DE_TU_SHEET",
        "sheetName": "Sesiones",
        "lookupColumn": "chat_id",
        "lookupValue": "={{ $json.message.chat.id }}"
      },
      "id": "gsheets-session-lookup",
      "name": "Buscar Sesion",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [350, 200]
    },
    {
      "parameters": {
        "chatId": "1126602445",
        "text": "🚨 *Fallo en Sistema:* {{ $json.execution.error.message }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-error-notify",
      "name": "Notificar Admin",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [350, 1000]
    }
  ],
  "connections": {
    "Bot Telegram": { "main": [[ { "node": "Buscar Sesion", "type": "main", "index": 0 } ]] },
    "Error Monitor": { "main": [[ { "node": "Notificar Admin", "type": "main", "index": 0 } ]] }
  },
  "settings": {
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "errorWorkflow": "W1ohdPWYsD6TwfKm"
  }
}